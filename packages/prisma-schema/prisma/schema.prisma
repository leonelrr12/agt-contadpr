generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Company {
  id        String   @id @default(cuid())
  name      String
  taxId     String
  taxIdHash String?  @unique  // HMAC-SHA256 con clave derivada — dedupe de RUC sin filtrar el valor
  address   String?
  phone     String?
  email     String?
  country   String   @default("PA")
  currency     String   @default("USD")
  declaraITBMS Boolean  @default(true)
  // Facturación (módulo Facturas PDF): logo y numeración autorizada por la DGI
  logo                  Bytes?
  facturaSerie          String?
  facturaResolucion     String?
  facturaResolucionFecha DateTime?
  facturaCorrelativo    Int      @default(0)
  // Cuenta bancaria por defecto para pagos desde chat/WS cuando no se
  // menciona el banco o el nombre no coincide (fallback: 1.1.02.01)
  bancoDefaultId        String?
  // Planilla (nómina): cuenta contable por columna del archivo maestro,
  // configurable en Administración → Configuración → Planilla.
  planillaSueldoId      String?
  planillaHorasExtrasId String?
  planillaDecimoId      String?
  planillaVacacionesId  String?
  planillaSSId          String?
  planillaSEId          String?
  planillaISRId         String?
  planillaBancoId       String?
  // Planilla (módulo): los aportes del patrono son un GASTO y su contrapartida un
  // PASIVO, así que no alcanza una sola cuenta aunque las dos puedan apuntar al mismo
  // pasivo que el obrero (a la CSS se le paga una sola vez, pero el gasto no es el
  // mismo que la retención). El pasivo son TRES cuentas —SS, SE y Riesgos
  // Profesionales—, una por concepto: sin configurar caen a la del obrero, y con el
  // catálogo partido cada subcuenta se descarga en el pago a la CSS con su propio
  // monto. `planillaOtrasDeduccionesId` es el destino de los préstamos y embargos;
  // sin ella, una corrida con otras deducciones se rechaza.
  planillaSSPatronalId       String?
  planillaSEPatronalId       String?
  planillaRiesgosPatronalId  String?
  planillaPatronalGastoId    String?
  planillaOtrasDeduccionesId String?
  // El gasto del patrono va a TRES cuentas, no a una: el Seguro Social, el Seguro
  // Educativo y los Riesgos Profesionales se analizan por separado. Si no están
  // configuradas, caen a los códigos 6.01.02.03 / .02 / .01 —las que el contador ya
  // tiene en su catálogo— y de última al gasto patronal genérico de arriba.
  planillaSSPatronalGastoId      String?
  planillaSEPatronalGastoId      String?
  planillaRiesgosProfesionalesId String?
  // Inventario: cuentas por defecto del kardex. Un producto puede sobreescribirlas;
  // si no, se resuelven por alias y por código (1.1.04.01 / 5.01.01).
  inventarioCuentaId    String?
  inventarioCostoId     String?
  createdAt    DateTime @default(now())
  updatedAt DateTime @updatedAt

  users          User[]
  accounts       Account[]
  concepts       Concept[]
  transactions   Transaction[]
  journalEntries JournalEntry[]
  subscriptions  Subscription[]
  apiKeys        ApiKey[]
  clients        Client[]
  suppliers      Supplier[]
  recurringTemplates RecurringTemplate[]
  bankStatements     BankStatement[]
  whatsappLinks      WhatsAppLink[]
  taxObligations     TaxObligation[]
  budgets            Budget[]
  inventoryProducts  InventoryProduct[]
  inventoryMovements InventoryMovement[]
  employees          Employee[]
  payrollRuns        PayrollRun[]
  payrollItems       PayrollItem[]
  payrollDeducciones PayrollDeduction[]
  payrollItemDeducciones PayrollItemDeduction[]
  payrollSettings    PayrollSettings?
  workerAccounts     WorkerAccount[]
  expenseClaims      ExpenseClaim[]
  reimbursements     Reimbursement[]
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String
  password  String
  role      String   @default("contador")
  companyId String
  isActive  Boolean  @default(true)
  emailVerified DateTime?
  /// Evidencia de la aceptación de los Términos y Condiciones: versión aceptada y
  /// cuándo. La versión vigente vive en `apps/api/src/lib/terms.ts`; si cambia el
  /// texto, se sube ahí y las cuentas viejas quedan con la versión anterior.
  termsVersion    String?
  termsAcceptedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company        Company         @relation(fields: [companyId], references: [id])
  authTokens     AuthToken[]
  transactions   Transaction[]
  journalEntries JournalEntry[]
  reviewedEntries JournalEntry[] @relation("ReviewedEntries")
  auditLogs      AuditLog[]
  recurringTemplates RecurringTemplate[]
  reimbursementsPaid Reimbursement[] @relation("ReimbursementsPaid")
}

model Account {
  id        String   @id @default(cuid())
  code      String
  name      String
  type      String   @default("GASTO")
  parentId  String?
  companyId String
  isActive  Boolean  @default(true)
  aliases   String[] @default([])  // Alias del motor contable (ej. 'caja', 'ventas')
  requiresAnexo Boolean @default(false)  // Lleva Anexo: exige RUC/Cédula y Nombre en las cargas
  isBlocked Boolean @default(false)      // Bloquear asientos: no admite movimientos nuevos
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company      Company       @relation(fields: [companyId], references: [id])
  parent       Account?      @relation("AccountHierarchy", fields: [parentId], references: [id])
  children     Account[]     @relation("AccountHierarchy")
  concepts     Concept[]
  journalLines JournalLine[]
  rulesFrom    AccountingRuleEntry[]
  bankStatements BankStatement[]
  budgets      Budget[]
  /// Cuentas por pagar de acreedores de planilla (una por acreedor).
  deduccionesPayroll PayrollDeduction[]

  @@unique([code, companyId])
}

model Concept {
  id         String   @id @default(cuid())
  name       String
  accountId  String
  companyId  String
  confidence Float    @default(0.9)
  isActive   Boolean  @default(true)
  keywords   String   @default("[]")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  account Account @relation(fields: [accountId], references: [id])
  company Company @relation(fields: [companyId], references: [id])

  @@unique([name, companyId])
}

model Transaction {
  id            String   @id @default(cuid())
  type          String
  amount        Float
  currency      String   @default("USD")
  description   String
  concept       String?
  paymentMethod String?
  date          DateTime
  metadata      String   @default("{}")
  companyId     String
  createdById   String
  journalEntryId String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  company      Company      @relation(fields: [companyId], references: [id])
  createdBy    User         @relation(fields: [createdById], references: [id])
  journalEntry JournalEntry? @relation(fields: [journalEntryId], references: [id])
}

model JournalEntry {
  id           String    @id @default(cuid())
  date         DateTime
  description  String
  status       String    @default("BORRADOR")
  period       String?   // Año fiscal del asiento de cierre (ej. "2026")
  isClosing    Boolean   @default(false) // Asiento de cierre de año — excluido de reportes
  companyId    String
  createdById  String
  reviewedById String?
  reviewedAt   DateTime?
  reviewNotes  String?
  reconciledAt DateTime?
  /// Asiento de reversión que lo anuló. Un asiento anulado NO deja de contar: se
  /// contabilizó y después se corrigió, así que sigue en los informes de su período
  /// y el reverso (fechado el día de la corrección) lo netea desde ese mes en
  /// adelante. Marcar el original como ANULADO lo borraba de su período, que es
  /// reescribir la historia. Esta marca es para la UI, no para los reportes.
  anuladoPorId String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  company      Company       @relation(fields: [companyId], references: [id])
  createdBy    User          @relation(fields: [createdById], references: [id])
  reviewedBy   User?         @relation("ReviewedEntries", fields: [reviewedById], references: [id])
  lines        JournalLine[]
  transactions Transaction[]
  recurringTemplates RecurringTemplate[]
  bankStatementRows  BankStatementRow[]
  /// Factura de un trabajador que este asiento saldó (reembolso), si vino de ahí.
  expenseClaim ExpenseClaim?
}

model JournalLine {
  id             String  @id @default(cuid())
  journalEntryId String
  accountId      String
  debit          Float   @default(0)
  credit         Float   @default(0)

  journalEntry JournalEntry @relation(fields: [journalEntryId], references: [id])
  account      Account      @relation(fields: [accountId], references: [id])
}

model AccountingRule {
  id        String   @id @default(cuid())
  name      String
  condition String   @default("{}")
  companyId String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  entries AccountingRuleEntry[]
}

model AccountingRuleEntry {
  id        String  @id @default(cuid())
  ruleId    String
  accountId String
  type      String

  rule    AccountingRule @relation(fields: [ruleId], references: [id])
  account Account        @relation(fields: [accountId], references: [id])
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String
  action    String
  entity    String
  entityId  String
  before    String?
  after     String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
}

model Plan {
  id            String   @id @default(cuid())
  name          String   @unique   // "Demo", "Emprendedor", "Pyme", "Despacho"
  description   String?           // Descripción visible en la UI
  monthlyLimit  Int                // Movimientos por período
  price         Float              // Precio en USD (0 = gratis/demo)
  features      String   @default("[]") // JSON array de funcionalidades
  isActive      Boolean  @default(true)
  sortOrder     Int      @default(0)    // Orden en la UI
  createdAt     DateTime @default(now())

  subscriptions Subscription[]
  @@map("plan")
}

enum SubscriptionStatus {
  DEMO
  ACTIVE
  EXPIRED
  GRACE
  GRANTED
}

enum PaymentMethod {
  YAPPY
  TRANSFERENCIA
  EFECTIVO
  GRANTED
  OTHER
}

model Subscription {
  id              String             @id @default(cuid())
  companyId       String
  planId          String
  status          SubscriptionStatus @default(DEMO)
  /// Fraccionario: la planilla SEMANAL consume media cuota (52 corridas al año contra
  /// 24 de la quincenal). Con un entero no habría forma de cobrar media.
  movementsUsed   Float              @default(0)
  movementsLimit  Int                // Límite del período actual (puede diferir del plan)
  periodStart     DateTime           @default(now())
  periodEnd       DateTime
  grantedBy       String?            // userId del admin que otorgó
  grantedNote     String?            // Nota del admin
  addons          String[]           @default([]) // add-ons contratados, ej. ["facturas-pdf"]
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  company         Company           @relation(fields: [companyId], references: [id])
  plan            Plan              @relation(fields: [planId], references: [id])
  payments        PaymentRecord[]

  @@index([companyId])
  @@index([status])
  @@map("subscription")
}

model PaymentRecord {
  id             String        @id @default(cuid())
  subscriptionId String
  amount         Float
  method         PaymentMethod @default(TRANSFERENCIA)
  reference      String?       // Número de comprobante / Yappy ID
  receivedBy     String?       // userId del admin que confirmó
  note           String?
  paidAt         DateTime      @default(now())
  createdAt      DateTime      @default(now())

  subscription   Subscription  @relation(fields: [subscriptionId], references: [id])

  @@index([subscriptionId])
  @@map("payment_record")
}

model ApiKey {
  id         String    @id @default(cuid())
  companyId  String
  name       String    // "Producción", "Test", "Zapier"
  keyHash    String    @unique  // SHA-256 del token completo
  prefix     String    @default("sk_live_")
  truncated  String    // "sk_live_8f3a...9b2c" para mostrar en UI
  lastUsedAt DateTime?
  createdAt  DateTime  @default(now())
  expiresAt  DateTime?
  isRevoked  Boolean   @default(false)

  company    Company   @relation(fields: [companyId], references: [id])

  @@index([companyId])
  @@index([keyHash])
  @@map("api_key")
}

model Client {
  id                      String     @id @default(cuid())
  companyId               String
  name                    String
  taxId                   String?    // RUC
  taxIdHash               String?    // HMAC determinista — dedupe de RUC sin filtrar el valor
  phone                   String?
  email                   String?
  address                 String?
  notes                   String?
  // Perfil de agente de retención ITBMS (retención SUFRIDA: el cliente retiene al pagarnos).
  // Vigencia evaluada contra la fecha de la factura (las listas DGI cambian por resolución).
  esAgenteRetenedor       Boolean    @default(false)
  porcentajeRetencionItbms Float     @default(0.5) // 50% del ITBMS (default DGI)
  vigenciaRetencionDesde  DateTime?
  vigenciaRetencionHasta  DateTime?
  createdAt               DateTime   @default(now())
  updatedAt               DateTime   @updatedAt

  company                 Company    @relation(fields: [companyId], references: [id])
  invoices                Invoice[]
  retencionesItbms        RetentionItbms[]

  @@unique([companyId, name])
  @@unique([companyId, taxIdHash])
  @@index([companyId])
  @@map("client")
}

model Supplier {
  id            String    @id @default(cuid())
  companyId     String
  name          String
  taxId         String?
  taxIdHash     String?    // HMAC determinista — dedupe de RUC sin filtrar el valor
  phone         String?
  email         String?
  paymentTerms  String?   @default("30") // días de crédito por defecto
  notes         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  company       Company   @relation(fields: [companyId], references: [id])
  bills         Bill[]
  /// Trabajadores por honorarios: facturan su trabajo Y adelantan compras.
  workerAccounts WorkerAccount[]

  @@unique([companyId, name])
  @@unique([companyId, taxIdHash])
  @@index([companyId])
  @@map("supplier")
}

model Invoice {
  id             String    @id @default(cuid())
  companyId      String
  clientId       String
  number         String?   // Número de factura emitida (correlativo del módulo Facturas PDF)
  amount         Float
  itbms          Float     @default(0)
  total          Float
  paidAmount     Float     @default(0) // Suma de abonos (InvoicePayment); PAGADA cuando ≈ total
  dueDate        DateTime
  paidAt         DateTime?
  status         String    @default("PENDIENTE") // PENDIENTE, VENCIDA, PAGADA
  date           DateTime  @default(now())
  description    String?
  paymentMethod  String?   // EFECTIVO | CREDITO (módulo Facturas PDF)
  journalEntryId String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  client         Client          @relation(fields: [clientId], references: [id])
  items          InvoiceItem[]
  payments       InvoicePayment[]
  retencionesItbms RetentionItbms[]

  @@unique([companyId, number])
  @@index([companyId])
  @@index([clientId])
  @@index([status])
  @@map("invoice")
}

model InvoicePayment {
  id              String    @id @default(cuid())
  companyId       String
  invoiceId       String
  amount          Float     // EFECTIVO recibido (conciliación bancaria)
  retentionAmount Float     @default(0) // retención ITBMS sufrida en este pago (crédito fiscal)
  date            DateTime  // fecha en que llegó el pago
  accountId       String?   // cuenta contable/banco donde llegó el depósito
  accountName     String?   // nombre tal como venía en el archivo (traza)
  journalEntryId  String?   // asiento BORRADOR de cobro creado
  createdAt       DateTime  @default(now())

  invoice         Invoice   @relation(fields: [invoiceId], references: [id])

  @@index([invoiceId])
  @@index([companyId])
  @@map("invoice_payment")
}

// Retención de ITBMS SUFRIDA (50% del ITBMS, retenida por un cliente agente al
// pagarnos). Es crédito fiscal del vendedor, no saldo de CxC. La factura se
// aplica por completo (efectivo + retención) y el crédito se compensa contra
// ITBMS por Pagar al declarar (Form. 430, renglón 52).
model RetentionItbms {
  id                String    @id @default(cuid())
  companyId         String
  clientId          String
  invoiceId         String
  invoicePaymentId  String?   // pago donde se materializó la retención
  fecha             DateTime  // fecha del pago/retención
  baseGravada       Float     // subtotal de la factura
  itbmsFacturado    Float     // ITBMS de la factura
  porcentaje        Float     // porcentaje aplicado (default 0.5)
  montoRetencion    Float
  numeroCertificado String?   // certificado del agente (soporte del crédito R52)
  fechaCertificado  DateTime?
  estado            String    @default("PENDIENTE") // PENDIENTE | RECIBIDA | APLICADA | ANULADA
  journalEntryId    String?   // asiento del cobro que la materializó
  notas             String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  client            Client    @relation(fields: [clientId], references: [id])
  invoice           Invoice   @relation(fields: [invoiceId], references: [id])

  @@index([companyId])
  @@index([clientId])
  @@index([invoiceId])
  @@index([estado])
  @@map("retencion_itbms")
}

model InvoiceItem {
  id          String   @id @default(cuid())
  invoiceId   String
  descripcion String
  cantidad    Int      @default(1)
  precio      Float    // precio unitario sin ITBMS
  itbms       Float    @default(0) // ITBMS de la línea (cantidad*precio*tasa)
  // Producto del kardex. Opcional a propósito: las facturas de servicios y las
  // históricas quedan sin producto y sin línea de costo en el asiento.
  productId   String?
  createdAt   DateTime @default(now())

  invoice Invoice           @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  product InventoryProduct? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([invoiceId])
  @@index([productId])
  @@map("invoice_item")
}

model Bill {
  id             String    @id @default(cuid())
  companyId      String
  supplierId     String
  number         String?   // Número de factura del proveedor
  amount         Float
  itbms          Float     @default(0)
  total          Float
  dueDate        DateTime
  paidAt         DateTime?
  status         String    @default("PENDIENTE") // PENDIENTE, VENCIDA, PAGADA
  date           DateTime  @default(now())
  description    String?
  journalEntryId String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  supplier       Supplier  @relation(fields: [supplierId], references: [id])

  @@index([companyId])
  @@index([supplierId])
  @@index([status])
  @@map("bill")
}

model OCRExample {
  id             String   @id @default(cuid())
  rawText        String
  correctedText  String?
  total          Float?
  date           String?
  provider       String?
  ruc            String?
  itbms          Float?
  imageHash      String?
  confidence     Float    @default(0)
  source         String   @default("tesseract+llm")
  companyId      String   @default("demo-company")
  createdById    String   @default("demo-user")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([provider])
  @@index([companyId])
}

model RecurringTemplate {
  id                  String    @id @default(cuid())
  companyId           String
  createdById         String
  description         String
  amount              Float
  concept             String?
  type                String
  paymentMethod       String?
  debitAccountId      String?
  creditAccountId     String?
  frequency           String    // DAILY, WEEKLY, MONTHLY, YEARLY
  dayOfMonth          Int?
  dayOfWeek           Int?
  nextRunAt           DateTime
  isActive            Boolean   @default(true)
  requireConfirmation Boolean   @default(true)
  lastRunAt           DateTime?
  lastEntryId         String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  company             Company        @relation(fields: [companyId], references: [id])
  createdBy           User           @relation(fields: [createdById], references: [id])
  lastEntry           JournalEntry?  @relation(fields: [lastEntryId], references: [id])

  @@index([companyId])
  @@index([nextRunAt])
  @@map("recurring_template")
}

model AuthToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique   // SHA-256 del token — nunca se guarda el token en claro
  type      String    // VERIFY_EMAIL | RESET_PASSWORD
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("auth_token")
}

model BankStatement {
  id              String    @id @default(cuid())
  companyId       String
  bankAccountId   String
  fileName        String?
  uploadDate      DateTime  @default(now())
  statementStart  DateTime?
  statementEnd    DateTime?
  openingBalance  Float     @default(0)
  closingBalance  Float     @default(0)
  status          String    @default("PENDING")
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  company         Company        @relation(fields: [companyId], references: [id])
  bankAccount     Account        @relation(fields: [bankAccountId], references: [id])
  rows            BankStatementRow[]

  @@index([companyId])
  @@index([bankAccountId])
  @@map("bank_statement")
}

model BankStatementRow {
  id              String         @id @default(cuid())
  statementId     String
  date            DateTime
  description     String
  reference       String?
  debit           Float          @default(0)
  credit          Float          @default(0)
  balance         Float?
  matchedEntryId  String?
  status          String         @default("UNMATCHED")
  matchConfidence Float?
  createdAt       DateTime       @default(now())

  statement       BankStatement  @relation(fields: [statementId], references: [id], onDelete: Cascade)
  matchedEntry    JournalEntry?  @relation(fields: [matchedEntryId], references: [id])

  @@index([statementId])
  @@index([matchedEntryId])
  @@index([status])
  @@map("bank_statement_row")
}

model ImportLog {
  id            String   @id @default(cuid())
  companyId     String
  createdById   String
  fileName      String
  rowsTotal     Int
  rowsSuccess   Int
  rowsError     Int
  errors        String   @default("[]")
  createdAt     DateTime @default(now())

  @@index([companyId])
  @@map("import_log")
}

model WhatsAppLink {
  id          String    @id @default(cuid())
  phoneNumber String    @unique
  companyId   String?
  label       String?
  code        String?              // Código de 6 dígitos para vinculación
  codeExpires DateTime?            // El código expira en 10 min
  verifiedAt  DateTime?            // null = pendiente de verificar
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  company     Company?  @relation(fields: [companyId], references: [id])
  /// Si el celular es de un TRABAJADOR que adelanta compras, apunta a su cuenta.
  /// Null = el número opera la empresa (comportamiento de siempre). Es la ÚNICA
  /// marca que distingue los dos modos: con esto, cada gasto que confirme ese
  /// celular nace como factura por reembolsar; sin esto, es un gasto de la empresa.
  workerAccountId String?
  workerAccount   WorkerAccount? @relation(fields: [workerAccountId], references: [id])

  @@index([companyId])
  @@index([phoneNumber])
  @@index([workerAccountId])
  @@map("whatsapp_link")
}

model TaxObligation {
  id              String    @id @default(cuid())
  companyId       String
  type            String    // ITBMS, CSS, ISR, AVISO, TASA_UNICA
  period          String    // "2026-07" (mensual) o "2026" (anual)
  label           String    // "Declaración ITBMS Julio 2026"
  dueDate         DateTime
  estimatedAmount Float?
  actualAmount    Float?
  status          String    @default("PENDING") // PENDING, COMPLETED, OVERDUE
  notes           String?
  completedAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  company         Company   @relation(fields: [companyId], references: [id])

  @@unique([companyId, type, period])
  @@index([companyId])
  @@index([dueDate])
  @@index([status])
  @@map("tax_obligation")
}

// Presupuesto por cuenta HOJA y mes. Un registro por empresa + cuenta + año + mes.
// El monto se guarda SIEMPRE POSITIVO y en la DIRECCIÓN NATURAL de la cuenta
// (INGRESO/PASIVO/PATRIMONIO acreditan; ACTIVO/GASTO/COSTO debitan) para que la
// grilla se lea como el negocio y la variación (real − presupuesto) tenga signo.
// El anual NO se guarda: es la suma de los 12 meses.
model Budget {
  id        String   @id @default(cuid())
  companyId String
  accountId String
  year      Int
  month     Int      // 1..12
  amount    Float    @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id])
  account Account @relation(fields: [accountId], references: [id])

  @@unique([companyId, accountId, year, month])
  @@index([companyId, year])
  @@index([accountId])
  @@map("budget")
}

// ── Inventario ──────────────────────────────────────────────────────────────
// Kardex de mercancía de REVENTA. La materia prima y los insumos NO van acá: son
// gasto (ver INVENTARIO.md §2). El módulo es independiente pero alimenta la
// contabilidad: cada movimiento tiene su asiento en BORRADOR.
//
// `stockActual` y `costoPromedio` son el estado VIGENTE, materializado para no
// recalcular el kardex entero en cada listado. La fuente de verdad histórica es
// InventoryMovement, y el estado tiene que ser siempre reconstruible desde ahí.

/// Producto de reventa con kardex.
model InventoryProduct {
  id          String   @id @default(cuid())
  companyId   String
  sku         String?  // código interno del negocio; opcional (en PG los NULL conviven en el unique)
  nombre      String
  descripcion String?
  unidad      String   @default("UND") // UND, LB, MT, CAJA…
  /// Precio de venta SIN ITBMS, igual que `InvoiceItem.precio`: el impuesto se
  /// calcula encima al facturar. Es solo una referencia para prellenar la factura —
  /// el precio que manda es el del renglón, así que puede quedar viejo sin romper nada.
  precioVenta Float?
  stockMinimo Float    @default(0)     // umbral de la alerta de reposición; 0 = sin alerta
  /// Saldo corrido vigente. Puede ser NEGATIVO si se vendió sin stock cargado;
  /// el módulo lo marca para regularizar en vez de bloquear la venta.
  stockActual   Float  @default(0)
  /// Valor vigente del inventario: el `saldoValor` del último movimiento. Se guarda
  /// explícito en vez de derivarlo de `stockActual × costoPromedio` para no depender
  /// de un ida y vuelta por punto flotante: es la cifra que tiene que cuadrar con el
  /// mayor al centavo, y no puede quedar a merced del redondeo.
  stockValor    Float  @default(0)
  /// Costo promedio ponderado vigente. Se DERIVA del kardex (stockValor / stockActual);
  /// puede quedar fraccionario, es un número de gestión y se redondea al mostrarlo.
  costoPromedio Float  @default(0)
  // Sobreescritura de las cuentas de la empresa para este producto.
  cuentaInventarioId String?
  cuentaCostoId      String?
  // Los productos NO se borran: se desactivan (el histórico del kardex los referencia).
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company      Company             @relation(fields: [companyId], references: [id])
  movements    InventoryMovement[]
  invoiceItems InvoiceItem[]

  @@unique([companyId, nombre])
  @@unique([companyId, sku])
  @@index([companyId, isActive])
  @@map("inventory_product")
}

/// Un movimiento del kardex: una fila por línea de documento.
///
/// El kardex NO se borra ni se edita — se corrige con el movimiento inverso
/// (`estado = ANULADO` + `revierteAId`), que devuelve las cantidades por aritmética
/// y no obliga a ningún reporte a filtrar nada.
///
/// `saldoValor` es la suma FIRMADA de los `costoTotal` que fueron al asiento, NO
/// `cantidad × promedio`. Esa es la decisión que hace que el kardex y el mayor
/// cuadren al centavo por construcción.
model InventoryMovement {
  id        String   @id @default(cuid())
  companyId String
  productId String
  /// Fecha del DOCUMENTO, a mediodía local (lib/dates.ts).
  fecha     DateTime
  tipo      String   // ENTRADA | SALIDA | AJUSTE_POSITIVO | AJUSTE_NEGATIVO
  origen    String   // COMPRA | VENTA | AJUSTE | APERTURA | REGULARIZACION | ANULACION
  /// SIEMPRE positiva: el signo lo da `tipo`. Así el kardex se lee en columnas
  /// Entradas/Salidas y ningún reporte tiene que mirar el signo. Vale 0 SOLO en la
  /// fila de regularización, que corrige valor sin mover unidades.
  cantidad      Float
  /// Costo de ESTE movimiento: en una compra el de la compra; en una salida el
  /// promedio vigente, salvo en un REVERSO, que repone al costo original del
  /// movimiento que anula (al promedio no devolvería el valor anterior).
  /// Precisión completa: el redondeo va en `costoTotal`.
  costoUnitario Float
  /// r2(cantidad × costoUnitario) — ES el monto que va al asiento, siempre POSITIVO.
  /// En la regularización es r2(unidades del faltante × costo de la compra).
  costoTotal    Float
  /// Saldo corrido DESPUÉS de este movimiento, en orden de REGISTRO (createdAt),
  /// no de fecha de documento: una factura retroactiva no puede reescribir los
  /// promedios de los movimientos posteriores.
  saldoCantidad      Float
  saldoValor         Float
  saldoCostoPromedio Float
  journalEntryId String? // asiento que lo refleja (BORRADOR hasta que el contador apruebe)
  invoiceId      String? // trazabilidad factura → kardex (origen VENTA)
  supplierId     String? // compra a crédito o al contado
  referencia     String? // Nº de factura del proveedor, motivo del ajuste…
  notas          String?
  /// Idempotencia: "venta:<invoiceId>:<productId>", "compra:<uuid>". Re-subir el
  /// mismo documento o un doble clic no duplica stock.
  dedupeKey      String?
  estado         String  @default("ACTIVO") // ACTIVO | ANULADO
  revierteAId    String? // si este movimiento es un reverso, cuál anula
  createdById    String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  company Company          @relation(fields: [companyId], references: [id])
  product InventoryProduct @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@unique([companyId, dedupeKey])
  @@index([companyId, productId, createdAt]) // el kardex de un producto (orden de registro)
  @@index([companyId, productId, fecha])     // valoración y reportes por fecha de documento
  @@index([companyId, fecha])                // libro de movimientos del período
  @@index([journalEntryId])                  // del asiento al movimiento (origen + cuadre)
  @@index([invoiceId])
  @@index([supplierId])
  @@map("inventory_movement")
}

// ─────────────────────────────────────────────────────────────────────────────
// Planilla (nómina panameña). Ver PLANILLA.md en la raíz del repo.

/// Empleado de la nómina. Es la identidad que la carga por archivo no tenía:
/// sin esto el sistema no sabe que el "Juan Pérez" de marzo y el de abril son la
/// misma persona, y por eso no puede acumular décimo, vacaciones ni prima.
///
/// `sueldoBase` es SIEMPRE mensual, incluso para quien cobra quincenal: el
/// `tipoPago` decide cómo se parte, no cómo se guarda. Así cambiar de quincenal a
/// mensual no obliga a reescribir la ficha ni a reinterpretar el histórico.
model Employee {
  id        String  @id @default(cuid())
  companyId String
  /// Identidad del empleado. Nullable a propósito: en Postgres los NULL conviven
  /// en el unique, así que los empleados sin cédula del archivo viejo no se pierden.
  cedula    String?
  /// Número de seguro social — la planilla de la CSS (SIPE) lo exige.
  nss       String?
  nombre    String
  cargo     String?
  sueldoBase Float
  tipoPago   String  @default("QUINCENAL") // QUINCENAL | MENSUAL
  /// Clase de riesgo profesional (I…V) para la tarifa de riesgos. Null = la tasa
  /// general de la empresa. Existe porque una misma empresa puede tener una oficina
  /// al 1,00% y un almacén con otra clase, y con una sola tasa eso no se representa.
  claseRiesgo String?
  /// Fechas a mediodía local (lib/dates.ts). Deciden si el empleado entra en una
  /// corrida y con cuántos días: un ingreso a mitad de quincena no cobra la quincena completa.
  fechaIngreso DateTime?
  fechaSalida  DateTime?
  /// Cuenta 1.1.02.x por la que sale SU neto; si falta, se resuelve por la cadena
  /// banco por defecto de la empresa → 1.1.02.01.
  bancoCuentaId String?
  cuentaBanco   String? // número de cuenta, solo informativo
  /// Saldos de los acumulados ANTES de usar el módulo. Es lo que permite arrancar
  /// desde un corte (p. ej. junio de ODESA) sin recargar años de planilla.
  decimoSaldoInicial     Float @default(0)
  vacacionesSaldoInicial Float @default(0)
  primaSaldoInicial      Float @default(0)
  fechaSaldoInicial      DateTime?
  // Los empleados NO se borran: se desactivan. El histórico de corridas y de
  // acumulados los referencia.
  isActive  Boolean  @default(true)
  notas     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company Company       @relation(fields: [companyId], references: [id])
  items   PayrollItem[]
  /// Deducciones de acreedores de este empleado (préstamos, embargos, mueblerías).
  deducciones      PayrollDeduction[]
  deduccionesItems PayrollItemDeduction[]
  /// Cuentas de trabajador (reembolsos) que apuntan a este empleado de planilla.
  workerAccounts   WorkerAccount[]

  @@unique([companyId, cedula])
  @@index([companyId, isActive])
  @@map("employee")
}

/// Una corrida de planilla: el período que se está pagando (una quincena, una
/// cuota del décimo, un pago de vacaciones). Agrupa los asientos de sus empleados
/// para poder revisarlos y anularlos en bloque.
///
/// `periodo` lleva la GRANULARIDAD dentro — "2026-06-Q1", "2026-06" (mensual),
/// "2026" (décimo), "2026-08-14" (eventual) — porque una nómina real mezcla gente
/// quincenal y mensual, y un solo formato no puede representar las dos.
/// `periodoMensual` ("2026-06") es la llave con el calendario CSS, sin parsear nada.
///
/// El estado se llama EJECUTADA y no CONFIRMADO a propósito: en este sistema
/// CONFIRMADO ya significa "el contador aprobó el asiento", y una corrida
/// "confirmada" con treinta asientos en BORRADOR sería una mentira en pantalla.
model PayrollRun {
  id             String @id @default(cuid())
  companyId      String
  tipo           String // SUELDO | DECIMO | VACACIONES
  periodicidad   String @default("QUINCENAL") // QUINCENAL | MENSUAL | ANUAL | EVENTUAL
  periodo        String
  periodoMensual String
  fechaDesde     DateTime
  fechaHasta     DateTime
  fechaPago      DateTime // a mediodía local
  status         String   @default("BORRADOR") // BORRADOR | EJECUTADA | ANULADA
  /// La corrida entera se contabilizó en UN asiento, en vez de uno por empleado.
  /// Es el caso de la semanal: 52 corridas al año por el asiento de cada empleado
  /// convertirían la cola de revisión del contador en el cuello de botella. Se guarda
  /// en la fila y no se deriva de `periodicidad` porque es un hecho de cómo se armó
  /// ESA corrida: cambiar la regla mañana no puede reinterpretar el pasado.
  consolidado    Boolean  @default(false)
  /// Totales congelados al ejecutar: la pantalla no recalcula la corrida, la lee.
  totalBruto               Float @default(0)
  totalDeducciones         Float @default(0)
  totalNeto                Float @default(0)
  totalPatronal            Float @default(0)
  totalDecimoGenerado      Float @default(0)
  totalVacacionesGeneradas Float @default(0)
  totalPrimaGenerada       Float @default(0)
  asientosCount            Int   @default(0)
  notas           String?
  motivoAnulacion String?
  createdById     String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  company Company       @relation(fields: [companyId], references: [id])
  items   PayrollItem[]
  /// El detalle por acreedor de esta corrida, congelado (una fila por deducción).
  deducciones PayrollItemDeduction[]

  // La idempotencia de la corrida —una sola corrida VIVA por período— la impone un
  // índice único PARCIAL que vive en SQL (migración 0023): Prisma no sabe expresar
  // el `WHERE`, y sin el parcial una corrida anulada seguiría bloqueando el período,
  // que es justo lo contrario de "se anula y se rehace". Mismo idioma que el guardia
  // de re-cierre de año en la migración 0006.
  @@index([companyId, tipo, periodo])
  @@index([companyId, fechaPago])
  @@index([companyId, periodoMensual]) // cruce con el calendario CSS
  @@map("payroll_run")
}

/// Un renglón de la corrida: un empleado con sus montos CONGELADOS.
///
/// La corrida no se recalcula, se anula y se rehace. Congelar los acumulados con su
/// factor es lo que hace que cambiar `factorDecimo` mañana no reescriba el pasado —
/// el mismo argumento por el que `InventoryMovement` guarda su costo unitario en vez
/// de depender del promedio vigente.
///
/// `neto` es el RESIDUO (bruto − deducciones ya redondeadas), nunca se recalcula
/// aparte: por eso el asiento cuadra por construcción y desaparece la clase de bug
/// del céntimo que absorbe diferencias en un monto que vino del archivo.
model PayrollItem {
  id             String @id @default(cuid())
  companyId      String
  runId          String
  employeeId     String
  diasTrabajados Int
  sueldo         Float  @default(0)
  horasExtras    Float  @default(0)
  /// Bono, viático: NO cotiza (no lleva SS ni SE) y debita la cuenta de sueldos.
  otrosIngresos  Float  @default(0)
  /// Descuento por ausencia o tardanza. NO es una deducción al neto: es salario no
  /// devengado, así que ya viene restado en `sueldo` y con él bajó la base de
  /// cotización. Se guarda aparte para poder mostrarlo en el renglón.
  menosSueldo    Float  @default(0)
  bruto          Float  @default(0)
  ss             Float  @default(0)
  se             Float  @default(0)
  isr            Float  @default(0)
  otrasDeducciones Float @default(0) // préstamos, embargos — exigen cuenta configurada
  neto           Float  @default(0)
  /// Aportes del patrono. Son costo de la empresa, no retención del empleado:
  /// por eso también van al asiento, aunque no toquen el neto. Se causan sobre
  /// sueldo, décimo y vacaciones, cada uno con su tasa.
  ssPatronal     Float  @default(0)
  sePatronal     Float  @default(0)
  riesgosPatronal Float @default(0)
  /// Acumulados generados en ESTA corrida, congelados con su factor.
  decimoGenerado      Float @default(0)
  vacacionesGeneradas Float @default(0)
  primaGenerada       Float @default(0)
  journalEntryId String?
  notas          String?
  createdAt      DateTime @default(now())

  company  Company    @relation(fields: [companyId], references: [id])
  run      PayrollRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  employee Employee   @relation(fields: [employeeId], references: [id], onDelete: Restrict)

  @@unique([runId, employeeId])
  @@index([companyId, employeeId]) // los acumulados por empleado
  @@index([journalEntryId])
  @@map("payroll_item")
}

/// Una deducción recurrente de un empleado a un ACREEDOR (banco, mueblería, juzgado).
///
/// Es el catálogo: se precarga sola en cada corrida de sueldo —igual que una plantilla
/// recurrente— y termina por cuotas o por saldo. Antes de esto, todo lo que no era SS,
/// SE ni ISR caía en UNA sola cuenta genérica y se tecleaba a mano en cada corrida, así
/// que el pasivo de cada acreedor no se podía conciliar ni pagar por separado.
///
/// `cuentaId` es la cuenta por pagar DEL ACREEDOR. `planillaOtrasDeduccionesId` queda
/// para lo que no tiene acreedor identificado (una deducción suelta que el contador
/// teclea en la corrida).
///
/// El SALDO no se guarda: se deriva de las cuotas aplicadas en `payroll_item_deduction`
/// —misma doctrina que los acumulados de décimo y vacaciones—, así anular una corrida
/// devuelve la cuota sin tocar nada y el saldo no puede mentir.
model PayrollDeduction {
  id         String @id @default(cuid())
  companyId  String
  employeeId String
  /// Texto libre: "Banco General — préstamo 1234". Viaja congelado al ítem de la corrida.
  acreedor   String
  cuentaId   String
  /// FIJO (monto por cuota) | PORCENTAJE (tasa sobre sueldo + horas extras).
  tipo       String @default("FIJO")
  montoFijo  Float?
  /// Tasa 0..1. La base es `sueldo + horasExtras` del período — lo mismo que cotiza
  /// (R2/R3): el bono y el viático no son salario, así que no entran.
  porcentaje Float?
  /// Cuotas que FALTAN desde el corte, no las pactadas originalmente: un préstamo de
  /// 24 cuotas con 10 pagadas se registra con `cuotas = 14` y su `saldoInicial`.
  cuotas     Int?
  /// Deuda total. Con esto la última cuota es el remanente y la deducción termina
  /// sola; sin `cuotas` ni `montoTotal` corre para siempre (se avisa en pantalla).
  montoTotal Float?
  /// Lo que se debía al registrarla, para deudas que ya venían a medias. Manda sobre
  /// `montoTotal` cuando está presente (mismo idioma que `Employee.decimoSaldoInicial`).
  saldoInicial Float?
  fechaInicio  DateTime?
  fechaFin     DateTime?
  /// El default correcto es el que NO cambia nada: la mayoría sigue corriendo en
  /// diciembre y la que se suspende se marca. Al revés, una deducción suspendida por
  /// defecto le pagaría de más al acreedor sin que nadie lo note hasta que reclame.
  aplicaEnDiciembre Boolean @default(true)
  isActive   Boolean @default(true)
  notas      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  company  Company                @relation(fields: [companyId], references: [id])
  employee Employee               @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  cuenta   Account                @relation(fields: [cuentaId], references: [id], onDelete: Restrict)
  items    PayrollItemDeduction[]

  @@index([companyId, employeeId, isActive])
  @@index([companyId, cuentaId])
  @@map("payroll_deduction")
}

/// El detalle CONGELADO de la deducción en una corrida: una fila por deducción.
///
/// Cuelga de la corrida (`runId` + `employeeId`, la misma clave que `PayrollItem`) y no
/// del ítem por una razón operatoria: el camino consolidado usa `createMany` —un solo
/// INSERT para treinta empleados dentro de una transacción de 5 segundos— y Prisma no
/// devuelve los ids de `createMany`. Con la misma clave, el detalle entra en un INSERT
/// más.
///
/// `monto > 0` es la ÚNICA marca de "cuota aplicada": el saldo es su suma y la cuota
/// que toca es el conteo + 1. Por eso una cuota SALTADA se guarda con `monto = 0` y
/// `omitida = true`: queda la constancia y no mueve ni el saldo ni el calendario.
///
/// `acreedor` y `cuentaId` son snapshot: cambiar la cuenta del catálogo mañana no puede
/// reescribir a dónde se acreditó ayer (misma doctrina que `PayrollItem.decimoGenerado`).
model PayrollItemDeduction {
  id            String  @id @default(cuid())
  companyId     String
  runId         String
  employeeId    String
  deduccionId   String
  acreedor      String
  cuentaId      String
  monto         Float   @default(0)
  omitida       Boolean @default(false)
  /// Por qué no se descontó: "la saltó el contador" | "suspendida en diciembre".
  motivoOmitida String?
  cuotaNumero   Int?
  createdAt     DateTime @default(now())

  company   Company          @relation(fields: [companyId], references: [id])
  run       PayrollRun       @relation(fields: [runId], references: [id], onDelete: Cascade)
  employee  Employee         @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  deduccion PayrollDeduction @relation(fields: [deduccionId], references: [id], onDelete: Restrict)

  @@unique([runId, employeeId, deduccionId])
  @@index([companyId, employeeId, deduccionId]) // derivar el saldo y el nº de cuota
  @@index([companyId, cuentaId])                // el pasivo por acreedor
  @@map("payroll_item_deduction")
}

/// Parámetros del módulo, 1:1 con la empresa. Se crea PEREZOSAMENTE con `upsert`:
/// nunca asumir que la fila existe.
///
/// `tablaISR` viaja como JSON en un String (la convención del repo: `Concept.keywords`,
/// `Transaction.metadata`). El default es `"[]"`, que significa **usar la tabla legal
/// del código**: así los valores por defecto viven en un solo sitio y la BD solo
/// guarda lo que el contador haya cambiado.
model PayrollSettings {
  id        String @id @default(cuid())
  companyId String @unique
  // Retenciones del empleado (verificadas contra los asientos ya cargados).
  ssObrero Float @default(0.0975)
  seObrero Float @default(0.0125)
  // Aportes del patrono. El Seguro Social del patrono es 13,25% (lo aclaró el
  // contador el 28-09) y los riesgos profesionales van APARTE, por clase: una tasa
  // que salía como "13,25 − 12,25" dejaba el aporte un punto abajo desde el arranque.
  ssPatronal Float @default(0.1325)
  sePatronal Float @default(0.015)
  /// Tasa general de Riesgos Profesionales: un aporte del patrono que va a su PROPIA
  /// cuenta de gasto, aparte del Seguro Social. Es la que se aplica al empleado que
  /// no tiene clase asignada; 1,00% corresponde a la clase I (oficina).
  riesgosProfesionales Float @default(0.01)
  /// Tarifa por clase de riesgo, en JSON (la convención de `tablaISR`). `"{}"` —el
  /// default— significa "usar la del código", que trae solo la clase I.
  ///
  /// Una clase SIN tasa no se asume en cero: la fila de ese empleado se rechaza con
  /// el motivo, porque un cero silencioso subvalúa el pasivo y nadie se entera.
  riesgosPorClase String @default("{}")
  /// El décimo NO cotiza como un sueldo: lleva SS a otra tasa y no lleva Seguro
  /// Educativo. Son parámetros y no constantes porque la tasa puede cambiar por ley.
  /// Verificado contra los asientos cargados: el empleado paga 7,25%.
  ssObreroDecimo Float @default(0.0725)
  seObreroDecimo Float @default(0)
  /// Aporte del patrono sobre el décimo. Es MENOR que el del sueldo (10,75% contra
  /// 13,25% en total) y va entero a la cuenta de Seguro Social del patrono.
  ssPatronalDecimo Float @default(0.1075)
  factorDecimo      Float @default(0.0833333333) // 1/12 del bruto del período
  factorVacaciones  Float @default(0.0833333333) // 1/12 — 30 días por año
  factorPrima       Float @default(0.0192307692) // 1/52 — una semana por año
  tablaISR          String @default("[]")        // [] = la tabla legal del código
  /// Apagado por defecto: los acumulados se calculan y se ven siempre, pero el
  /// asiento de provisión solo se genera si el contador lo enciende.
  provisionarPrestaciones Boolean @default(false)
  /// Día de la semana en que se paga la nómina semanal, con el 0 = domingo de
  /// `Date.getDay()`. Default: viernes (5), que es la semana vencida.
  ///
  /// Existe porque de él sale el CALENDARIO del pago semanal: cuántos pagos tiene el
  /// mes (4 o 5) y cuál de ellos es este. Sin ese dato, el ISR del mes no cierra
  /// exacto —el último pago se lleva el resto— y la corrida no puede saber qué
  /// semana está pagando.
  diaPagoSemanal Int @default(5)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id])
  @@map("payroll_settings")
}

// ══════════════════════════════════════════════════════════════════════════
// Reembolsos a trabajadores
//
// El trabajador adelanta de su bolsillo compras de la operación (insumos,
// comida, materia prima), las facturas llegan por WhatsApp desde SU celular, y
// la empresa le devuelve el dinero. No tiene usuario en el sistema: su
// identidad es el número desde el que escribe.
//
// Contabilidad (decidida con el dueño): la factura se registra al recibirla
// contra un PASIVO, no contra el banco — el dinero todavía no salió.
//
//     al llegar la factura:  DR Gasto/Compra   CR 2.1.02.02 Reembolsos Empleados por Pagar
//     al pagar (N facturas): DR 2.1.02.02      CR Banco
//
// Por eso el trabajador es el ACREEDOR y "cuánto me deben" (/viaticos) es el
// saldo de sus facturas sin pagar.
//
// Dos ejes de estado que NO se mezclan: el asiento tiene el suyo
// (BORRADOR/CONFIRMADO/RECHAZADO = validez contable) y la factura el del
// reembolso (PENDIENTE/PAGADO = tesorería). Un gasto puede estar aprobado y
// todavía sin pagar, que es justo lo que el panel tiene que mostrar.
// ══════════════════════════════════════════════════════════════════════════

/// El trabajador y su celular. Se crea desde el panel (o por API) ANTES de que
/// el número empiece a mandar facturas: el webhook resuelve por
/// `whatsapp_link.workerAccountId`, así que un celular sin cuenta sigue operando
/// como la empresa, no como trabajador.
model WorkerAccount {
  id          String  @id @default(cuid())
  companyId   String
  /// Tal como lo manda el gateway: "50761234567". Es la llave con la que el
  /// webhook reconoce quién escribe.
  phoneNumber String
  nombre      String
  /// Enlaces OPCIONALES y solo de trazabilidad: en planilla o por honorarios.
  /// La contabilidad del reembolso es idéntica en los dos casos — el trabajador
  /// es el acreedor por lo que puso de su bolsillo, sin importar cómo se le paga
  /// su trabajo (y por eso el pago del reembolso no se mezcla con el de sus
  /// honorarios, que lleva su propia retención).
  employeeId  String?
  supplierId  String?
  isActive    Boolean @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company  Company   @relation(fields: [companyId], references: [id])
  employee Employee? @relation(fields: [employeeId], references: [id])
  supplier Supplier? @relation(fields: [supplierId], references: [id])
  links    WhatsAppLink[]
  claims   ExpenseClaim[]
  reimbursements Reimbursement[]

  @@unique([companyId, phoneNumber])
  @@index([companyId, isActive])
  @@map("worker_account")
}

/// Factura RECIBIDA: el registro durable de todo documento que entró por
/// WhatsApp con datos propios (URL del CUTE, XML oficial de la DGI, RUC, número,
/// fecha y total), para poder listarlo o consultarlo después sin depender de que
/// el visor de la DGI siga sirviéndola.
///
/// Cumple dos papeles según tenga o no `workerId`:
///  · con trabajador → además es un REEMBOLSO: lo que él adelantó de su bolsillo
///    y la empresa le debe (el saldo que responde /viaticos);
///  · sin trabajador → es una factura de la EMPRESA, y solo se archiva.
model ExpenseClaim {
  id             String    @id @default(cuid())
  companyId      String
  /// Null = factura de la EMPRESA: se registra para poder consultarla después
  /// (con su URL del CUTE y su XML), pero no hay a quién reembolsar. Con
  /// `workerId`, además es un reembolso pendiente de ese trabajador.
  workerId       String?
  /// Enlace del QR de la factura electrónica (CUTE). Null si llegó como PDF sin URL.
  dgiUrl         String?
  /// XML oficial que la DGI embebe en el visor del CUTE: es el documento legal
  /// (~10-25 KB; Postgres lo comprime). El PDF es solo su representación.
  dgiXml         String?
  proveedor      String?
  rucEmisor      String?
  numeroFactura  String?
  fecha          DateTime
  total          Float
  itbms          Float     @default(0)
  /// RUC+número+fecha+total; si falta alguno, la URL. Evita que la MISMA factura
  /// entre dos veces, la mande quien la mande. Null = no se pudo identificar
  /// (Postgres deja convivir varios NULL en el unique).
  dedupeKey      String?
  /// @unique: un asiento salda UNA factura, y así lo garantiza la BD.
  journalEntryId String?   @unique
  /// PENDIENTE = el trabajador todavía no cobró; PAGADO lo marca el reembolso.
  /// El estado contable (BORRADOR/CONFIRMADO/RECHAZADO) vive en el asiento, no acá:
  /// son dos ejes distintos y el panel muestra los dos.
  status         String    @default("PENDIENTE")
  reimbursementId String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  company        Company        @relation(fields: [companyId], references: [id])
  worker         WorkerAccount? @relation(fields: [workerId], references: [id])
  journalEntry   JournalEntry?  @relation(fields: [journalEntryId], references: [id])
  reimbursement  Reimbursement? @relation(fields: [reimbursementId], references: [id])

  @@unique([companyId, dedupeKey])
  @@index([companyId, status])
  @@index([companyId, workerId, status])
  @@map("expense_claim")
}

/// Un pago de reembolso: agrupa las facturas que se le pagaron al trabajador de
/// una sola vez. La cuenta bancaria no se guarda acá — vive en las líneas del
/// asiento, que es el registro contable real.
model Reimbursement {
  id             String   @id @default(cuid())
  companyId      String
  workerId       String
  monto          Float
  fecha          DateTime
  journalEntryId String?
  paidById       String?
  paidAt         DateTime @default(now())
  notas          String?
  createdAt      DateTime @default(now())

  company  Company       @relation(fields: [companyId], references: [id])
  worker   WorkerAccount @relation(fields: [workerId], references: [id])
  paidBy   User?         @relation("ReimbursementsPaid", fields: [paidById], references: [id])
  claims   ExpenseClaim[]

  @@index([companyId, workerId])
  @@map("reimbursement")
}
