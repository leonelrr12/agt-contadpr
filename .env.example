# Base de datos
DATABASE_URL="postgresql://contador:CHANGE_ME@localhost:5432/agt_contador?schema=public"

# DeepSeek API (LLM)
DEEPSEEK_API_KEY=sk-your-key-here

# JWT Secret — usa un valor aleatorio largo en producción
JWT_SECRET="genera-un-secret-aleatorio-de-64-caracteres"

# CORS — restringe al dominio de producción
CORS_ORIGIN="*"

# ITBMS — tasa estándar Panamá
ITBMS_RATE="0.07"
ITBMS_ENABLED="true"

# Email (MailerApi local del VPS)
MAILER_API_URL=http://localhost:3004
MAILER_API_KEY=
APP_URL=https://contador507.com

# Cifrado en reposo de campos sensibles (AES-256-GCM). Generar con: openssl rand -base64 32
FIELD_ENC_KEY=

# Facturación electrónica (PAC / agente autorizado de la DGI).
# Sin PAC_COMPANY_UUID y PAC_API_KEY la emisión electrónica queda apagada.
# QA de Factura Fácil: https://backend-qa-api.facturafacil.com.pa
PAC_PROVIDER=FACTURA_FACIL
PAC_ENVIRONMENT=PRUEBAS
PAC_BASE_URL=https://backend-qa-api.facturafacil.com.pa
PAC_COMPANY_UUID=
PAC_API_KEY=
# HTTP Basic (si el PAC lo exige además del API key). Van juntas o ninguna.
PAC_BASIC_USER=
PAC_BASIC_PASSWORD=
# Sucursal emisora: UUID en cabecera (X-FF-Branch) o código de 4 caracteres en el cuerpo.
PAC_BRANCH_UUID=
PAC_BRANCH_CODE=
PAC_POS=001
PAC_TIMEOUT_MS=20000
